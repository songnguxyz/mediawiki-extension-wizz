{
	"root": true,
	"extends": [
		"wikimedia/client",
		"wikimedia/vue3/es6",
		"wikimedia/mediawiki"
	],
	"overrides": [
		{
			"files": [ "tests/**", "build/**", "dev/**", "vite.config.js" ],
			"extends": "wikimedia/server"
		},
		{
			"files": [ "src/wizz-form.js", "src/*.vue" ],
			"parserOptions": { "sourceType": "module", "ecmaVersion": 2018 }
		},
		{
			"files": [ "tests/**" ],
			"extends": "wikimedia/qunit"
		}
	]
}
